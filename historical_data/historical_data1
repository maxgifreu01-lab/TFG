from AlgorithmImports import *

class BuyAndExplicitSell(QCAlgorithm):

    def Initialize(self):
        self.SetStartDate(2020, 1, 1)
        self.SetEndDate(2024, 1, 1)
        self.SetCash(100000)

        self.ticker = "SPY"
        self.AddEquity(self.ticker, Resolution.Daily)

        self.invested = False

    def OnData(self, data):

        if not data.ContainsKey(self.ticker) or data[self.ticker] is None:
            return

        if not self.invested and self.Time.year == 2020:

            
            self.SetHoldings(self.ticker, 1.0)
            self.invested = True

            self.Log(f"COMPRA: Se ha comprado el 100% de {self.ticker} en {self.Time.date()}")

        elif self.invested and self.Time.year == 2023 and self.Time.month == 12 and self.Time.day >= 27:

           
            self.Liquidate(self.ticker)
            self.invested = False

            self.Log(f"VENTA: Se ha vendido todo de {self.ticker} en {self.Time.date()}")